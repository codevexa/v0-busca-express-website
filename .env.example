# =============================================================================
# OSSALA | Controle de Entregas — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel (produção).
# NUNCA versione valores reais.
# =============================================================================

# --- Supabase (obrigatórias) --------------------------------------------------
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_...). A chave "anon" legada também funciona:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave privilegiada — SOMENTE no servidor. Necessária para criar usuários,
# redefinir senhas, revogar sessões de usuários desativados e para o cron de
# retenção de fotos. Aceita também SUPABASE_SECRET_KEY (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# --- Empresa ------------------------------------------------------------------
# Slug da empresa exibida na tela de login (identidade visual pública).
NEXT_PUBLIC_COMPANY_SLUG=empresa-principal
# Domínio dos e-mails internos gerados a partir da matrícula.
AUTH_INTERNAL_EMAIL_DOMAIN=ossala.internal
# URL pública do app (links de recuperação de senha).
NEXT_PUBLIC_APP_URL=

# --- OCR da conferência por foto ----------------------------------------------
# Chave da API da Anthropic (Claude, visão). Sem ela, o OCR fica indisponível e a
# conferência pode ser feita manualmente.
ANTHROPIC_API_KEY=
# Opcional: modelo usado no OCR (padrão claude-opus-5-5).
# OCR_MODEL=

# --- Mapas (OpenStreetMap / Nominatim) ----------------------------------------
# E-mail de contato exigido pela política de uso do Nominatim.
NOMINATIM_EMAIL=
# Opcional: servidor Nominatim próprio/contratado.
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Rotinas agendadas --------------------------------------------------------
# Segredo enviado pelo Vercel Cron para /api/cron/retencao (limpeza de fotos).
CRON_SECRET=
